# ==============================================================================
# EVENTORA BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and provide your specific credentials.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/eventora?retryWrites=true&w=majority

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
MAIL_ADDRESS=noreply@yourdomain.com

# JWT & Authentication
SECRET_KEY=generate_a_cryptographically_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_TOKEN_EXPIRE_MINUTES=60

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your_super_admin_secure_password

# CORS Settings
CORS_ORIGINS=*

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
PAYMENT_PROVIDER=RAZORPAY
MERCHANDISE_PAYMENT_PROVIDER=RAZORPAY
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Unified Notifications (Firebase Cloud Messaging)
NOTIFICATIONS_ENABLED=true
NOTIFICATION_WEBSOCKET_ENABLED=true
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
PUSH_PROVIDER=FCM
FCM_CREDENTIALS_PATH=firebase_service_account.json

# Web Push (VAPID)
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:noreply@yourdomain.com

# ==============================================================================
# OFFICIAL DIGILOCKER OAUTH 2.0 INTEGRATION (Govt of India / MeitY)
# Note: DigiLocker handles all citizen authentication and SMS OTP on its portal.
# No third-party SMS gateway (Twilio, Fast2SMS, MSG91) is required or permitted.
# ==============================================================================
DIGILOCKER_CLIENT_ID=your_registered_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_registered_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/digilocker/callback
DIGILOCKER_AUTH_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_USER_INFO_URL=https://api.digitallocker.gov.in/public/oauth2/1/user
DIGILOCKER_EAADHAAR_URL=https://api.digitallocker.gov.in/public/oauth2/2/xml/eaadhaar
DIGILOCKER_REVOKE_URL=https://api.digitallocker.gov.in/public/oauth2/1/revoke
DIGILOCKER_ENV=sandbox
DIGILOCKER_SCOPE=openid profile eaadhaar
